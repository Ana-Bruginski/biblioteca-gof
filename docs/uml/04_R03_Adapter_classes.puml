@startuml
!include _estilo.iuml
title R03 · Adapter: integração com bancos incompatíveis
interface GatewayDeCobranca <<Target>> {
  + emitirBoleto(s : SolicitacaoCobranca) : Cobranca
  + consultarSituacao(c : Cobranca) : SituacaoCobranca
}
interface ReceptorDePagamento <<Target das notificações>> {
  + confirmar(c : ConfirmacaoPagamento) : void
}
interface BancoSimulavel {
  + simularPagamento(c : Cobranca, idPagamento : String) : void
}
class AdaptadorBancoA <<Adapter>> {
  + emitirBoleto(s) : Cobranca
  + consultarSituacao(c) : SituacaoCobranca
  + receberWebhook(json : String) : void
  + simularPagamento(c, idPagamento) : void
  - paraCentavos(valor : BigDecimal) : long
  - traduzir(status : StatusA) : SituacaoCobranca
}
class AdaptadorBancoB <<Adapter>> {
  + emitirBoleto(s) : Cobranca
  + consultarSituacao(c) : SituacaoCobranca
  + receberNotificacao(xml : String) : void
  + simularPagamento(c, idPagamento) : void
  - paraDocumento(cpf : String) : String
  - traduzir(situacao : String) : SituacaoCobranca
}
class ApiBancoA <<Adaptee>> {
  + gerarTitulo(cpf : String, centavos : long) : TituloA
  + consultarTitulo(nossoNumero : String) : StatusA
  + liquidar(nossoNumero, idPagamento) : String
}
class ApiBancoB <<Adaptee>> {
  + abrirCobranca(documento : String, valorDecimal : BigDecimal) : CobrancaB
  + statusCobranca(txid : String) : String
  + concluir(txid, e2eid) : String
}
class ServicoDeMulta <<Client>>
class ServicoDeQuitacao {
  + confirmar(conf : ConfirmacaoPagamento) : void
  + quantidadeDeQuitacoes() : int
  + pendentesDeConciliacao() : List<ConfirmacaoPagamento>
}
class RegistroDeCobrancas {
  + registrar(c : Cobranca) : void
  + buscar(banco : CodigoBanco, idExterno : String) : Optional<Cobranca>
  + quitarSeAberta(idCobranca, idPagamento) : boolean {synchronized}
}
class Cobranca {
  - idCobranca : String
  - banco : CodigoBanco
  - idExterno : String
  - valor : BigDecimal
  - linhaDigitavel : String
  - situacao : SituacaoCobranca
  - idPagamento : String
}
class SolicitacaoCobranca <<record>> {
  + idCobranca : String
  + cpf : String
  + valor : BigDecimal
}
class ConfirmacaoPagamento <<record>> {
  + banco : CodigoBanco
  + idExterno : String
  + idPagamento : String
  + valorPago : BigDecimal
}
GatewayDeCobranca <|.. AdaptadorBancoA
GatewayDeCobranca <|.. AdaptadorBancoB
BancoSimulavel <|.. AdaptadorBancoA
BancoSimulavel <|.. AdaptadorBancoB
AdaptadorBancoA --> "1" ApiBancoA : -api
AdaptadorBancoB --> "1" ApiBancoB : -api
AdaptadorBancoA --> "1" ReceptorDePagamento : -receptor
AdaptadorBancoB --> "1" ReceptorDePagamento : -receptor
ReceptorDePagamento <|.. ServicoDeQuitacao
ServicoDeQuitacao --> "1" RegistroDeCobrancas : -registro
RegistroDeCobrancas o--> "0..*" Cobranca
ServicoDeMulta --> "1" GatewayDeCobranca : -gateway
GatewayDeCobranca ..> SolicitacaoCobranca
ReceptorDePagamento ..> ConfirmacaoPagamento
note bottom of AdaptadorBancoA
  A: R$ 7,00 -> 700 centavos; notificação em JSON (webhook)
end note
note bottom of AdaptadorBancoB
  B: R$ 7,00 -> 7.00 decimal; CPF formatado; notificação em XML
end note
note right of RegistroDeCobrancas
  quitarSeAberta é atômica: notificação
  repetida não gera segunda quitação.
end note
note left of ServicoDeMulta
  Sem condicional por banco: conhece só GatewayDeCobranca.
  O adaptador da instalação é escolhido em app/Sistema (banco=A|B).
end note
@enduml
