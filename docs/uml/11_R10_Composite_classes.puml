@startuml
!include _estilo.iuml
title R10 · Composite: organização hierárquica do acervo
abstract class ComponenteDoAcervo <<Component>> {
  - nome : String
  + {abstract} contarLivros() : int
  + {abstract} listarIds() : List<String>
  + getNome() : String
  + getPai() : GrupoDoAcervo
  ~ definirPai(novoPai : GrupoDoAcervo) : void
}
class ItemDoAcervo <<Leaf>> {
  - idLivro : String {readOnly}
  + getIdLivro() : String
  + contarLivros() : int
  + listarIds() : List<String>
}
class GrupoDoAcervo <<Composite>> {
  - tipo : TipoDeGrupo
  + adicionar(c : ComponenteDoAcervo) : void
  + remover(c : ComponenteDoAcervo) : void
  + contarLivros() : int
  + listarIds() : List<String>
  - ehAncestralDe(c : ComponenteDoAcervo) : boolean
  - raiz() : GrupoDoAcervo
}
enum TipoDeGrupo <<enumeration>> {
  UNIDADE
  SECAO
  SUBSECAO
}
class OrganizadorDoAcervo <<Client>> {
  - raiz : GrupoDoAcervo
  - grupos : Map<String, GrupoDoAcervo>
  + criarGrupo(nome, tipo : TipoDeGrupo, nomeDoPai) : GrupoDoAcervo
  + adicionarLivro(idLivro, nomeDoGrupo) : void
  + mover(idLivro, nomeDoDestino) : void
  + contarLivros(nomeDoGrupo) : int
  + grupo(nome) : GrupoDoAcervo
  + desenhar() : String
}
class TratadorDeOrganizacao {
  + criarGrupo(nome, tipo, nomeDoPai) : Resultado
  + adicionarLivro(idLivro, nomeDoGrupo) : Resultado
  + moverLivro(idLivro, nomeDoDestino) : Resultado
  + contarLivros(nomeDoGrupo) : Resultado
}
class HierarquiaInvalidaException
class Livro
ComponenteDoAcervo <|-- ItemDoAcervo
ComponenteDoAcervo <|-- GrupoDoAcervo
GrupoDoAcervo "0..1 -pai" o-- "0..* -filhos" ComponenteDoAcervo
GrupoDoAcervo --> TipoDeGrupo
OrganizadorDoAcervo --> "1" GrupoDoAcervo : -raiz
TratadorDeOrganizacao --> "1" OrganizadorDoAcervo
ItemDoAcervo ..> Livro : referencia só pelo id
GrupoDoAcervo ..> HierarquiaInvalidaException : <<create>>
note right of GrupoDoAcervo
  contarLivros() soma contarLivros() dos filhos
  (recursivo); o item devolve 1.
  adicionar() recusa: ciclo (c é o grupo ou um ancestral),
  componente que já tem pai e livro já presente na árvore.
end note
note bottom of OrganizadorDoAcervo
  mover() tira o item da origem e põe no destino;
  se o destino recusar, devolve à origem.
  Não toca no Livro nem na Movimentacao.
end note
@enduml
