@startuml
!include _estilo.iuml
autonumber
title R01 · Sequência: terceira renovação recusada sem alterar o vencimento
participant ":TratadorDeEmprestimo" as T
participant ":ServicoDeCirculacao" as F
participant "s:SessaoDeDados" as S
participant ":Movimentacao" as M
participant ":AcervoDeLivros" as A
participant "l:Livro" as L
participant ":Renovado" as R
T -> F : renovar(idLivro)
F -> S ** : abrir(fabrica)
F -> M : buscarEmprestimoAtivo(idLivro)
M --> F : emp
F -> A : buscarLivro(idLivro)
A --> F : l
F -> L : renovar()
L -> R : renovar(l)
alt numRenovacoes < 2
  R -> L : prorrogar(30)
  R -> L : mudarPara(Renovado.INSTANCIA)
  F -> M : registrarEmprestimo(emp.comVencimento(...))
  F -> A : atualizar(l)
  F -> S : confirmar()
  F --> T : ComprovanteRenovacao
else numRenovacoes = 2 (terceira tentativa)
  R --> F : RenovacaoNegadaException
  note right of R : guarda avaliada antes de prorrogar:\nvencimento e contador intactos
  F -> S : desfazer()
  F --> T : exceção
  T -> T : Resultado.recusado(motivo)
end
== Variante: reservar livro DEVOLVIDO ==
F -> L : reservar(e)
L -> L : estado.reservar(l, e)
note right of L : Devolvido não sobrescreve reservar():\nEstadoLivro lança OperacaoInvalidaException\nsem alterar o Livro
@enduml
