@startuml
!include _estilo.iuml
title R07 · Template Method: rotina comum para cadastros
abstract class "TratadorDeCadastro<T, D>" as TC <<AbstractClass>> {
  # fabrica : FabricaDePersistencia
  + incluir(dados : D) : ResultadoCadastro<T> {leaf}
  # {abstract} buscarExistente(dados : D) : T
  # {abstract} validar(dados : D) : void
  # verificarPreRequisitos(dados : D) : void
  # {abstract} criar(dados : D) : T
  # {abstract} armazenar(entidade : T) : void
  # apresentar(entidade : T, novo : boolean) : ResultadoCadastro<T>
}
class TratadorDeAcervo <<ConcreteClass>> {
  - consulta : ConsultaAcervo
  # buscarExistente(d : DadosLivro) : Livro
  # validar(d : DadosLivro) : void
  # criar(d : DadosLivro) : Livro
  # armazenar(livro : Livro) : void
  + buscarNoCatalogo(termo) : List<MetadadosLivro>
}
class TratadorDePessoa <<ConcreteClass>> {
  # buscarExistente(d : DadosPessoa) : Pessoa
  # validar(d : DadosPessoa) : void
  # criar(d : DadosPessoa) : Pessoa
  # armazenar(p : Pessoa) : void
}
class TratadorDeEstudante <<ConcreteClass>> {
  - pessoas : iPessoa
  # buscarExistente(d : DadosEstudante) : Estudante
  # validar(d : DadosEstudante) : void
  # verificarPreRequisitos(d : DadosEstudante) : void
  # criar(d : DadosEstudante) : Estudante
  # armazenar(e : Estudante) : void
}
class TratadorDeAtendente <<ConcreteClass>> {
  - pessoas : iPessoa
  # buscarExistente(d : DadosAtendente) : Atendente
  # validar(d : DadosAtendente) : void
  # verificarPreRequisitos(d : DadosAtendente) : void
  # criar(d : DadosAtendente) : Atendente
  # armazenar(a : Atendente) : void
}
interface iLivro {
  + inserirLivro(idLivro, titulo) : ResultadoCadastro<Livro>
  + consultarLivro(idLivro) : Optional<Livro>
  + atualizarLivro(idLivro, titulo) : boolean
  + excluirLivro(idLivro) : boolean
}
interface iPessoa {
  + inserirPessoa(cpf, nome, sobrenome, email) : ResultadoCadastro<Pessoa>
  + consultarPessoa(cpf) : Optional<Pessoa>
  + atualizarPessoa(cpf, nome, sobrenome, email) : boolean
  + excluirPessoa(cpf) : boolean
}
interface iEstudante {
  + inserirEstudante(cpf, idEstudante, matricula) : ResultadoCadastro<Estudante>
  + consultarEstudante(cpf) : Optional<Estudante>
  + atualizarEstudante(cpf, matricula) : boolean
  + excluirEstudante(cpf) : boolean
}
interface iAtendente {
  + inserirAtendente(cpf, idAtendente, setor) : ResultadoCadastro<Atendente>
  + consultarAtendente(cpf) : Optional<Atendente>
  + atualizarAtendente(cpf, setor) : boolean
  + excluirAtendente(cpf) : boolean
}
class "ResultadoCadastro<T>" as RC <<record>> {
  + status : StatusCadastro
  + entidade : T
  + motivo : String
}
enum StatusCadastro <<enumeration>> {
  CRIADO
  EXISTENTE
  RECUSADO
}
TC <|-- TratadorDeAcervo : <<bind>> T=Livro, D=DadosLivro
TC <|-- TratadorDePessoa : <<bind>> T=Pessoa, D=DadosPessoa
TC <|-- TratadorDeEstudante : <<bind>> T=Estudante, D=DadosEstudante
TC <|-- TratadorDeAtendente : <<bind>> T=Atendente, D=DadosAtendente
iLivro <|.. TratadorDeAcervo
iPessoa <|.. TratadorDePessoa
iEstudante <|.. TratadorDeEstudante
iAtendente <|.. TratadorDeAtendente
TratadorDeEstudante --> "1" iPessoa : -pessoas
TratadorDeAtendente --> "1" iPessoa : -pessoas
TC ..> RC : <<create>>
RC --> StatusCadastro
note right of TC
  incluir() é final (não pode ser sobrescrito):
  1 buscarExistente -> se achou, apresentar(existente, false)
  2 validar
  3 verificarPreRequisitos (gancho: vazio por padrão)
  4 criar
  5 armazenar
  6 apresentar(novo, true)
  Falha antes do passo 5: nada é gravado.
end note
@enduml
