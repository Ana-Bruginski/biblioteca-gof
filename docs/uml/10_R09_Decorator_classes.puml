@startuml
!include _estilo.iuml
title R09 · Decorator: serviço de consulta com recursos opcionais
interface ConsultaAcervo <<Component>> {
  + buscarMetadados(criterio : Criterio) : List<MetadadosLivro>
}
class ConsultaAcervoBasica <<ConcreteComponent>> {
  - fabrica : FabricaDePersistencia
  + buscarMetadados(c : Criterio) : List<MetadadosLivro>
}
abstract class DecoradorDeConsulta <<Decorator>> {
  # interno : ConsultaAcervo
  + buscarMetadados(criterio : Criterio) : List<MetadadosLivro>
}
class DecoradorDeMedicao <<ConcreteDecorator>> {
  - metricas : RegistroDeMetricas
  + buscarMetadados(criterio) : List<MetadadosLivro>
}
class DecoradorDeCache <<ConcreteDecorator>> {
  - cache : Map<Criterio, Entrada>
  - ttl : Duration
  - relogio : Relogio
  + buscarMetadados(criterio) : List<MetadadosLivro>
  + invalidar() : void
  + acertos() : int
  + faltas() : int
}
class MontadorDeConsulta {
  + {static} montar(basica, cfg : ConfigInstalacao, metricas, relogio) : ConsultaAcervo
}
class ConfigInstalacao <<record>> {
  + medicao : boolean
  + cache : boolean
  + ttlCache : Duration
}
class MetadadosLivro <<record>> {
  + id : String
  + titulo : String
}
class TratadorDeAcervo <<Client>> {
  - consulta : ConsultaAcervo
  + buscarNoCatalogo(termo) : List<MetadadosLivro>
}
class RegistroDeMetricas {
  + registrar(d : Duration) : void
}
ConsultaAcervo <|.. ConsultaAcervoBasica
ConsultaAcervo <|.. DecoradorDeConsulta
DecoradorDeConsulta <|-- DecoradorDeMedicao
DecoradorDeConsulta <|-- DecoradorDeCache
DecoradorDeConsulta o--> "1" ConsultaAcervo : #interno
TratadorDeAcervo --> "1" ConsultaAcervo : -consulta
DecoradorDeMedicao --> "1" RegistroDeMetricas
MontadorDeConsulta ..> DecoradorDeCache : <<create>>
MontadorDeConsulta ..> DecoradorDeMedicao : <<create>>
MontadorDeConsulta ..> ConfigInstalacao
ConsultaAcervo ..> MetadadosLivro
note right of MontadorDeConsulta
  Cadeia montada conforme a instalação:
  Medicao( Cache( Basica ) ).
  A medição fica por fora para medir
  também os acertos do cache.
end note
note bottom of DecoradorDeCache
  Guarda só metadados (id e título).
  Se o cache falhar, consulta o interno.
  A reserva lê sempre o Livro atual no Acervo:
  o cache não participa da decisão.
end note
@enduml
