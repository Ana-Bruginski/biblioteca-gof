@startuml
!include _estilo.iuml
autonumber
title R04 · Sequência: efetivar empréstimo pela fachada
actor Atendente
participant ":Main" as UI
participant ":TratadorDeEmprestimo" as T
participant ":ServicoDeCirculacao" as F
participant "s:SessaoDeDados" as S
participant ":Relacionamento" as R
participant ":Movimentacao" as M
participant ":AcervoDeLivros" as A
participant "l:Livro" as L
Atendente -> UI : opção 9 (idLivro, cpf)
UI -> T : emprestarLivro(idLivro, cpf)
T -> F : efetivarEmprestimo(idLivro, cpf)
F -> S ** : abrir(fabrica)
F -> R : buscarEstudante(cpf)
F -> M : buscarReservaAtiva(idLivro)
alt sem estudante ou reserva de outro CPF
  F -> S : desfazer()
  F --> T : ReservaInvalidaException
  T --> UI : Resultado.recusado(motivo)
else reserva válida
  F -> A : buscarLivro(idLivro)
  F -> L : emprestar(e, hoje)
  note right of L : RESERVADO -> EMPRESTADO\nvencimento = hoje + 7
  F -> M : removerReserva(r)
  F -> M : registrarEmprestimo(emp)
  F -> A : atualizar(l)
  F -> S : confirmar()
  F --> T : ComprovanteEmprestimo
  T --> UI : Resultado.ok(...)
end
@enduml
