@startuml
!include _estilo.iuml
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #3C3489
  ArrowColor #333333
}
title Máquina de estados do Livro
[*] --> LIVRE : Livro(id, titulo)
LIVRE --> RESERVADO : reservar(e) [e cadastrado] / reservante := e
RESERVADO --> EMPRESTADO : emprestar(e, hoje) [e = reservante] / vencimento := hoje + 7
EMPRESTADO --> RENOVADO : renovar() [numRenovacoes < 2] / vencimento += 30; numRenovacoes++
RENOVADO --> RENOVADO : renovar() [numRenovacoes < 2] / vencimento += 30; numRenovacoes++
EMPRESTADO --> DEVOLVIDO : devolver()
RENOVADO --> DEVOLVIDO : devolver()
DEVOLVIDO --> LIVRE : aprovarInspecao() / limparCiclo()
DEVOLVIDO --> REPARANDO : enviarParaReparo()
LIVRE --> REPARANDO : enviarParaReparo()
REPARANDO --> LIVRE : concluirReparo() / limparCiclo()
REPARANDO --> INCINERADO : registrarLaudoIrrecuperavel() / limparCiclo()
LIVRE --> [*] : excluir()
INCINERADO --> [*]
note right of DEVOLVIDO
  reservar() não é aceito aqui:
  livro devolvido ainda não inspecionado
  não pode ser reservado.
end note
note "Cada transição é um método da classe do estado de origem.\nEvento não aceito: OperacaoInvalidaException, sem alterar o Livro.\nrenovar() com numRenovacoes = 2: RenovacaoNegadaException." as N1
@enduml
