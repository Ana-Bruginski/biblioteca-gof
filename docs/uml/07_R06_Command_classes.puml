@startuml
!include _estilo.iuml
title R06 · Command: solicitações de circulação como objetos
abstract class SolicitacaoDeCirculacao <<Command>> {
  - id : UUID {readOnly}
  - autor : String {readOnly}
  - criadaEm : Instant {readOnly}
  + {abstract} executar(circulacao : iCirculacao) : ResultadoSolicitacao
  + getId() : UUID
  + getAutor() : String
  + getCriadaEm() : Instant
}
class SolicitacaoDeReserva <<ConcreteCommand>> {
  - idLivro : String
  - cpf : String
  + {static} nova(autor, idLivro, cpf) : SolicitacaoDeReserva
  + executar(circulacao : iCirculacao) : ResultadoSolicitacao
}
class SolicitacaoDeRenovacao <<ConcreteCommand>> {
  - idLivro : String
  + {static} nova(autor, idLivro) : SolicitacaoDeRenovacao
  + executar(circulacao : iCirculacao) : ResultadoSolicitacao
}
class ExecutorDeSolicitacoes <<Invoker>> {
  + submeter(s : SolicitacaoDeCirculacao) : ResultadoSolicitacao
}
class RegistroDeSolicitacoes {
  - reservadas : Set<UUID>
  - resultados : Map<UUID, ResultadoSolicitacao>
  + reservarExecucao(id : UUID) : boolean
  + concluir(id : UUID, r : ResultadoSolicitacao) : void
  + resultadoDe(id : UUID) : Optional<ResultadoSolicitacao>
  + liberar(id : UUID) : void
}
interface iCirculacao <<Receiver>> {
  + reservar(idLivro, cpf) : ComprovanteReserva
  + renovar(idLivro) : ComprovanteRenovacao
}
class Main <<Client>>
class TratadorDeEmprestimo {
  + submeter(s : SolicitacaoDeCirculacao) : ResultadoSolicitacao
}
class ResultadoSolicitacao <<record>> {
  + idSolicitacao : UUID
  + status : Status
  + mensagem : String
}
enum Status <<enumeration>> {
  EXECUTADA
  RECUSADA
  EM_PROCESSAMENTO
}
SolicitacaoDeCirculacao <|-- SolicitacaoDeReserva
SolicitacaoDeCirculacao <|-- SolicitacaoDeRenovacao
Main ..> SolicitacaoDeReserva : <<create>>
Main ..> SolicitacaoDeRenovacao : <<create>>
Main ..> TratadorDeEmprestimo : submeter
TratadorDeEmprestimo --> "1" ExecutorDeSolicitacoes : -executor
ExecutorDeSolicitacoes --> "1" iCirculacao : -receptor
ExecutorDeSolicitacoes --> "1" RegistroDeSolicitacoes : -registro
SolicitacaoDeCirculacao ..> iCirculacao : <<use>> recebido em executar()
ResultadoSolicitacao +-- Status
ExecutorDeSolicitacoes ..> ResultadoSolicitacao
note right of RegistroDeSolicitacoes
  reservarExecucao(id) usa um conjunto concorrente
  (ConcurrentHashMap.newKeySet): só a primeira
  submissão do mesmo id executa, mesmo simultânea.
end note
note bottom of SolicitacaoDeCirculacao
  Não há desfazer(): a entrega física do livro
  não é revertida por software. As regras
  continuam no domínio (receptor e Livro).
end note
@enduml
