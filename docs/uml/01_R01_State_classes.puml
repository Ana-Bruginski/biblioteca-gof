@startuml
!include _estilo.iuml
title R01 · State: ciclo de vida do Livro (diagrama de classes)
class Livro <<Context>> {
  + {static} PRAZO_EMPRESTIMO_DIAS : int = 7
  + {static} DIAS_POR_RENOVACAO : int = 30
  - id : String {readOnly}
  - titulo : String
  - estado : EstadoLivro
  - vencimento : LocalDate
  - numRenovacoes : int
  - cpfReservante : String
  + Livro(id : String, titulo : String)
  + {static} reconstituir(id, titulo, situacao : Situacao, vencimento, numRenovacoes, cpfReservante) : Livro
  + reservar(e : Estudante) : void
  + emprestar(e : Estudante, hoje : LocalDate) : void
  + renovar() : void
  + devolver() : void
  + aprovarInspecao() : void
  + enviarParaReparo() : void
  + concluirReparo() : void
  + registrarLaudoIrrecuperavel() : void
  + excluir() : void
  + getSituacao() : Situacao
  ~ mudarPara(novo : EstadoLivro) : void
  ~ prorrogar(dias : int) : void
  ~ definirReservante(cpf : String) : void
  ~ definirVencimento(data : LocalDate) : void
  ~ limparCiclo() : void
}
abstract class EstadoLivro <<State>> {
  ~ reservar(l : Livro, e : Estudante) : void
  ~ emprestar(l : Livro, e : Estudante, hoje : LocalDate) : void
  ~ renovar(l : Livro) : void
  ~ devolver(l : Livro) : void
  ~ aprovarInspecao(l : Livro) : void
  ~ enviarParaReparo(l : Livro) : void
  ~ concluirReparo(l : Livro) : void
  ~ registrarLaudoIrrecuperavel(l : Livro) : void
  ~ excluir(l : Livro) : void
  + {abstract} situacao() : Situacao
  # recusa(operacao : String) : OperacaoInvalidaException
}
class Livre <<ConcreteState>> {
  + {static} INSTANCIA : Livre
  ~ reservar(l, e) : void
  ~ enviarParaReparo(l) : void
  ~ excluir(l) : void
}
class Reservado <<ConcreteState>> {
  + {static} INSTANCIA : Reservado
  ~ emprestar(l, e, hoje) : void
}
class Emprestado <<ConcreteState>> {
  + {static} INSTANCIA : Emprestado
  ~ renovar(l) : void
  ~ devolver(l) : void
}
class Renovado <<ConcreteState>> {
  + {static} INSTANCIA : Renovado
}
class Devolvido <<ConcreteState>> {
  + {static} INSTANCIA : Devolvido
  ~ aprovarInspecao(l) : void
  ~ enviarParaReparo(l) : void
}
class Reparando <<ConcreteState>> {
  + {static} INSTANCIA : Reparando
  ~ concluirReparo(l) : void
  ~ registrarLaudoIrrecuperavel(l) : void
}
class Incinerado <<ConcreteState>> {
  + {static} INSTANCIA : Incinerado
}
enum Situacao <<enumeration>> {
  LIVRE
  RESERVADO
  EMPRESTADO
  RENOVADO
  DEVOLVIDO
  REPARANDO
  INCINERADO
  + estado() : EstadoLivro
}
class OperacaoInvalidaException
class RenovacaoNegadaException
Livro "*" --> "1" EstadoLivro : -estado
EstadoLivro <|-- Livre
EstadoLivro <|-- Reservado
EstadoLivro <|-- Emprestado
Emprestado <|-- Renovado
EstadoLivro <|-- Devolvido
EstadoLivro <|-- Reparando
EstadoLivro <|-- Incinerado
EstadoLivro ..> Situacao : situacao()
Situacao ..> EstadoLivro : estado() reconstitui
EstadoLivro ..> OperacaoInvalidaException : <<create>>
Emprestado ..> RenovacaoNegadaException : <<create>>
note right of EstadoLivro
  Cada evento, por padrão, recusa
  sem alterar o Livro.
  Cada estado sobrescreve só o que é válido.
end note
note bottom of Emprestado
  renovar: guarda [numRenovacoes < 2]
  avaliada ANTES de prorrogar(30).
  Renovado herda renovar() e devolver().
end note
note bottom of Situacao
  É o valor gravado na persistência.
  Na leitura, estado() devolve o objeto de estado.
end note
@enduml
