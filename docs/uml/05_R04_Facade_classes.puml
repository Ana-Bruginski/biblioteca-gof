@startuml
!include _estilo.iuml
title R04 · Facade: entrada única para as operações de circulação
interface iCirculacao <<Facade (contrato)>> {
  + reservar(idLivro, cpf) : ComprovanteReserva
  + consultarReservas(cpf) : List<ComprovanteReserva>
  + efetivarEmprestimo(idLivro, cpf) : ComprovanteEmprestimo
  + renovar(idLivro) : ComprovanteRenovacao
  + consultar(idLivro) : SituacaoDTO
  + devolver(idLivro) : ComprovanteDevolucao
  + registrarInspecao(idLivro, laudo : Laudo) : SituacaoDTO
  + enviarParaReparo(idLivro) : SituacaoDTO
  + concluirReparo(idLivro) : SituacaoDTO
  + registrarLaudoIrrecuperavel(idLivro) : SituacaoDTO
}
class ServicoDeCirculacao <<Facade>> {
  - fabrica : FabricaDePersistencia
  - relogio : Relogio
  - emTransacao(operacao : Function<SessaoDeDados,T>) : T
  - alterarLivro(idLivro, evento : Consumer<Livro>) : SituacaoDTO
  - {static} paraDTO(l : Livro) : SituacaoDTO
}
class TratadorDeEmprestimo <<Client>> {
  + reservarLivro(idLivro, cpf) : Resultado
  + consultarReservas(cpf) : List<ComprovanteReserva>
  + emprestarLivro(idLivro, cpf) : Resultado
  + renovarEmprestimo(idLivro) : Resultado
  + consultarSituacao(idLivro) : Resultado
  + submeter(s : SolicitacaoDeCirculacao) : ResultadoSolicitacao
}
class TratadorDeDevolucao <<Client>> {
  + registrarDevolucao(idLivro) : Resultado
  + emitirBoletoDeMulta(idLivro, cpf) : Resultado
  + registrarInspecao(idLivro, laudo : Laudo) : Resultado
  + enviarParaReparo(idLivro) : Resultado
  + concluirReparo(idLivro) : Resultado
  + registrarLaudoIrrecuperavel(idLivro) : Resultado
}
class SessaoDeDados <<Subsistema>> {
  + {static} abrir(f : FabricaDePersistencia) : SessaoDeDados
  + acervo() : AcervoDeLivros
  + relacionamento() : Relacionamento
  + movimentacao() : Movimentacao
  + confirmar() : void
  + desfazer() : void
}
class AcervoDeLivros <<Subsistema>> {
  + buscarLivro(id) : Livro
  + incluir(l : Livro) : void
  + atualizar(l : Livro) : void
  + excluir(id) : void
}
class Relacionamento <<Subsistema>> {
  + buscarPessoa(cpf) : Optional<Pessoa>
  + buscarEstudante(cpf) : Estudante
  + buscarAtendente(cpf) : Optional<Atendente>
}
class Movimentacao <<Subsistema>> {
  + registrarReserva(r : Reserva) : void
  + buscarReservaAtiva(idLivro) : Optional<Reserva>
  + listarReservasDe(cpf) : List<Reserva>
  + removerReserva(r : Reserva) : void
  + registrarEmprestimo(e : Emprestimo) : void
  + buscarEmprestimoAtivo(idLivro) : Optional<Emprestimo>
  + removerEmprestimoAtivo(idLivro) : void
  + registrarDevolucao(d : Devolucao) : void
}
class Livro <<Subsistema (State)>>
class ComprovanteEmprestimo <<record DTO>> {
  + idEmprestimo : String
  + idLivro : String
  + cpf : String
  + emprestadoEm : LocalDate
  + vencimento : LocalDate
}
class "ComprovanteReserva\nComprovanteRenovacao\nComprovanteDevolucao\nSituacaoDTO" as Outros <<record DTO>>
iCirculacao <|.. ServicoDeCirculacao
TratadorDeEmprestimo --> "1" iCirculacao : -circulacao
TratadorDeDevolucao --> "1" iCirculacao : -circulacao
ServicoDeCirculacao ..> SessaoDeDados : <<use>> abre 1 por operação
SessaoDeDados *--> "1" AcervoDeLivros
SessaoDeDados *--> "1" Relacionamento
SessaoDeDados *--> "1" Movimentacao
ServicoDeCirculacao ..> Livro : <<use>>
ServicoDeCirculacao ..> ComprovanteEmprestimo : <<create>>
ServicoDeCirculacao ..> Outros : <<create>>
note right of ServicoDeCirculacao
  Cada operação roda em emTransacao:
  abrir -> passos -> confirmar();
  qualquer exceção -> desfazer() e repassa.
  Devolve comprovantes (DTOs), nunca coleções internas.
end note
note left of TratadorDeEmprestimo
  A interface (Main) só chama os tratadores;
  os tratadores só delegam à fachada.
end note
@enduml
