@startuml
!include _estilo.iuml
title R08 · Abstract Factory: famílias compatíveis de acesso aos dados
interface FabricaDePersistencia <<AbstractFactory>> {
  + criarUnidadeDeTrabalho() : UnidadeDeTrabalho
  + criarRepositorioLivro(uow : UnidadeDeTrabalho) : RepositorioLivro
  + criarRepositorioMovimentacao(uow : UnidadeDeTrabalho) : RepositorioMovimentacao
  + criarRepositorioRelacionamento(uow : UnidadeDeTrabalho) : RepositorioRelacionamento
  + familia() : String
  + inicializar() : void
}
class FabricaEmMemoria <<ConcreteFactory>> {
  - base : BaseEmMemoria
  - daFamilia(uow) : UnidadeDeTrabalhoEmMemoria
}
class FabricaMySQL <<ConcreteFactory>> {
  - parametros : ParametrosMySQL
  + inicializar() : void
  - daFamilia(uow) : UnidadeDeTrabalhoMySQL
}
interface UnidadeDeTrabalho <<AbstractProduct>> {
  + confirmar() : void
  + desfazer() : void
}
interface RepositorioLivro <<AbstractProduct>> {
  + buscar(id) : Optional<Livro>
  + listar() : List<Livro>
  + salvar(livro : Livro) : void
  + remover(id) : void
}
interface RepositorioMovimentacao <<AbstractProduct>>
interface RepositorioRelacionamento <<AbstractProduct>>
class UnidadeDeTrabalhoEmMemoria <<ConcreteProduct>>
class RepositorioLivroEmMemoria <<ConcreteProduct>>
class RepositorioMovimentacaoEmMemoria <<ConcreteProduct>>
class RepositorioRelacionamentoEmMemoria <<ConcreteProduct>>
class UnidadeDeTrabalhoMySQL <<ConcreteProduct>> {
  - conexao : Connection
}
class RepositorioLivroMySQL <<ConcreteProduct>>
class RepositorioMovimentacaoMySQL <<ConcreteProduct>>
class RepositorioRelacionamentoMySQL <<ConcreteProduct>>
class ConfiguradorDePersistencia {
  + {static} fabricaPara(perfil : Perfil, parametros : ParametrosMySQL) : FabricaDePersistencia
}
enum Perfil <<enumeration>> {
  TESTE
  PRODUCAO
}
class SessaoDeDados <<Client>>
class FamiliaIncompativelException
FabricaDePersistencia <|.. FabricaEmMemoria
FabricaDePersistencia <|.. FabricaMySQL
UnidadeDeTrabalho <|.. UnidadeDeTrabalhoEmMemoria
UnidadeDeTrabalho <|.. UnidadeDeTrabalhoMySQL
RepositorioLivro <|.. RepositorioLivroEmMemoria
RepositorioLivro <|.. RepositorioLivroMySQL
RepositorioMovimentacao <|.. RepositorioMovimentacaoEmMemoria
RepositorioMovimentacao <|.. RepositorioMovimentacaoMySQL
RepositorioRelacionamento <|.. RepositorioRelacionamentoEmMemoria
RepositorioRelacionamento <|.. RepositorioRelacionamentoMySQL
FabricaEmMemoria ..> UnidadeDeTrabalhoEmMemoria : <<create>>
FabricaEmMemoria ..> RepositorioLivroEmMemoria : <<create>>
FabricaEmMemoria ..> RepositorioMovimentacaoEmMemoria : <<create>>
FabricaEmMemoria ..> RepositorioRelacionamentoEmMemoria : <<create>>
FabricaMySQL ..> UnidadeDeTrabalhoMySQL : <<create>>
FabricaMySQL ..> RepositorioLivroMySQL : <<create>>
FabricaMySQL ..> RepositorioMovimentacaoMySQL : <<create>>
FabricaMySQL ..> RepositorioRelacionamentoMySQL : <<create>>
RepositorioLivroEmMemoria --> "1" UnidadeDeTrabalhoEmMemoria : -uow
RepositorioLivroMySQL --> "1" UnidadeDeTrabalhoMySQL : -uow
ConfiguradorDePersistencia ..> FabricaEmMemoria : <<create>> TESTE
ConfiguradorDePersistencia ..> FabricaMySQL : <<create>> PRODUCAO
ConfiguradorDePersistencia ..> Perfil
SessaoDeDados ..> FabricaDePersistencia : <<use>>
FabricaMySQL ..> FamiliaIncompativelException : <<create>>
FabricaEmMemoria ..> FamiliaIncompativelException : <<create>>
note bottom of ConfiguradorDePersistencia
  A família é escolhida UMA vez, pelo perfil
  (app.properties: perfil=TESTE|PRODUCAO),
  em app/Sistema. Sem perfil: erro, sem omissão.
end note
note bottom of FamiliaIncompativelException
  daFamilia(uow) recusa a unidade de outra família:
  não dá para misturar memória com MySQL.
  Todos os repositórios de uma operação
  compartilham a mesma unidade de trabalho.
end note
note "Oracle é réplica mantida pela infraestrutura:\nnenhuma fábrica cria repositório que escreva nele." as N1
@enduml
