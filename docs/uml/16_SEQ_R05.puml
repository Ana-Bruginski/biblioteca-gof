@startuml
!include _estilo.iuml
autonumber
title R05 · Sequência: devolução atrasada notifica os ouvintes
participant ":Main" as UI
participant ":TratadorDeDevolucao" as T
participant ":ServicoDeCirculacao" as F
participant ":PublicadorDeDevolucao" as P
participant ":OuvinteInspecao" as OI
participant ":OuvinteMulta" as OM
participant ":OuvinteIndicadores" as OD
participant ":OuvinteEmail" as OE
UI -> T : registrarDevolucao(idLivro)
T -> F : devolver(idLivro)
note right of F : transação: Livro -> DEVOLVIDO,\nremove empréstimo, registra Devolucao,\nconfirmar()
F --> T : ComprovanteDevolucao
T -> T : ev = EventoDevolucao.de(comprovante)
T -> P : publicar(ev)
loop para cada ouvinte (cada um em try/catch)
  P -> OI : aoDevolver(ev)
  OI -> OI : agenda.agendar(idLivro)
  P -> OM : aoDevolver(ev)
  opt ev.diasAtraso() > 0
    OM -> OM : financeiro.solicitarMulta(...)
  end
  P -> OD : aoDevolver(ev)
  P -> OE : aoDevolver(ev)
  opt envio falha
    OE --> P : exceção
    P -> P : falhas.add(FalhaDeOuvinte)
  end
end
T --> UI : Resultado.ok("livro DEVOLVIDO aguardando inspecao")
note over T, P : Publicado só depois da confirmação.\nO livro fica DEVOLVIDO até a decisão da inspeção.
@enduml
